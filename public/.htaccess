RewriteEngine On

# ── Archivos que existen (js, css, imágenes, robots.txt…): servirlos tal cual ──
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Si el dominio ya apunta a /public, aceptar igual las rutas con public/ adelante ──
# (ej: /public/js/montos.js → js/montos.js)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^public/(.+)$ $1 [L]

# Tienda
RewriteRule ^evento/talle/?$ index.php?route=evento_talle [L,QSA]
RewriteRule ^sitemap\.xml$ index.php?route=sitemap [L,QSA]
RewriteRule ^tienda/?$ index.php?route=tienda [L,QSA]
RewriteRule ^producto/([a-zA-Z0-9-]+)/?$ index.php?route=producto&slug=$1 [L,QSA]
RewriteRule ^categoria/([a-zA-Z0-9-]+)/?$ index.php?route=tienda&categoria=$1 [L,QSA]

# Carrito
RewriteRule ^carrito/?$ index.php?route=carrito [L,QSA]
RewriteRule ^carrito/agregar/?$ index.php?route=carrito_agregar [L,QSA]
RewriteRule ^carrito/actualizar/?$ index.php?route=carrito_actualizar [L,QSA]
RewriteRule ^carrito/eliminar/([0-9]+)/?$ index.php?route=carrito_eliminar&id=$1 [L,QSA]

# Checkout
RewriteRule ^checkout/?$ index.php?route=checkout [L,QSA]
RewriteRule ^checkout/invitado/?$ index.php?route=checkout&invitado=1 [L,QSA]
RewriteRule ^checkout/guardar/?$ index.php?route=checkout_guardar [L,QSA]

# Pedido confirmado
RewriteRule ^pedido/gracias/?$ index.php?route=pedido_gracias [L,QSA]

# Auth cliente
RewriteRule ^ingresar/?$ index.php?route=cliente_login [L,QSA]
RewriteRule ^registro/?$ index.php?route=cliente_registro [L,QSA]
RewriteRule ^salir/?$ index.php?route=cliente_logout [L,QSA]
RewriteRule ^cliente/ingresar/?$ index.php?route=cliente_ingresar [L,QSA]
RewriteRule ^cliente/guardar-registro/?$ index.php?route=cliente_guardar_registro [L,QSA]

# Recuperar contraseña
RewriteRule ^olvide-mi-password/?$ index.php?route=olvide_password [L,QSA]
RewriteRule ^solicitar-reset/?$ index.php?route=solicitar_reset [L,QSA]
RewriteRule ^nueva-password/?$ index.php?route=nueva_password [L,QSA]
RewriteRule ^guardar-nueva-password/?$ index.php?route=guardar_nueva_password [L,QSA]

# Cuenta del cliente
RewriteRule ^mi-cuenta/pedidos/?$ index.php?route=cliente_pedidos [L,QSA]
RewriteRule ^mi-cuenta/pedido/([0-9]+)/?$ index.php?route=cliente_pedido_detalle&id=$1 [L,QSA]

# Panel admin
RewriteRule ^admin/?$ index.php?route=dashboard [L,QSA]
RewriteRule ^admin/pedidos/?$ index.php?route=admin_pedidos [L,QSA]
RewriteRule ^admin/pedido/([0-9]+)/?$ index.php?route=admin_pedido_detalle&id=$1 [L,QSA]
RewriteRule ^admin/pedido/estado/?$ index.php?route=admin_pedido_estado [L,QSA]

RewriteRule ^admin/pedido/cobro/?$         index.php?route=pedido_cobro          [L,QSA]
RewriteRule ^admin/pedido/anular-cobro/?$  index.php?route=pedido_anular_cobro   [L,QSA]
RewriteRule ^admin/pedido/usar-saldo/?$    index.php?route=pedido_usar_saldo     [L,QSA]
RewriteRule ^admin/pedido/condiciones/?$   index.php?route=pedido_condiciones    [L,QSA]
RewriteRule ^admin/pedido/nota/?$          index.php?route=pedido_nota           [L,QSA]
RewriteRule ^admin/pedido/cancelar/?$      index.php?route=pedido_cancelar       [L,QSA]
RewriteRule ^admin/pedido/contactado/?$    index.php?route=pedido_contactado     [L,QSA]

RewriteRule ^admin/clientes/?$ index.php?route=admin_clientes [L,QSA]
RewriteRule ^admin/cliente/?$ index.php?route=admin_cliente_detalle [L,QSA]
RewriteRule ^admin/cliente/password/?$ index.php?route=admin_cliente_password [L,QSA]
RewriteRule ^admin/estadisticas/?$ index.php?route=admin_estadisticas [L,QSA]

RewriteRule ^admin/estadisticas/campania/crear/?$     index.php?route=admin_estadisticas_campania_crear     [L,QSA]
RewriteRule ^admin/estadisticas/campania/eliminar/?$  index.php?route=admin_estadisticas_campania_eliminar  [L,QSA]

RewriteRule ^admin/estadisticas/diagnostico/?$ index.php?route=admin_estadisticas_diagnostico [L,QSA]

# Caja
RewriteRule ^admin/caja/config/?$            index.php?route=caja_config            [L,QSA]
RewriteRule ^admin/caja/config/caja/?$       index.php?route=caja_config_caja       [L,QSA]
RewriteRule ^admin/caja/config/medio/?$      index.php?route=caja_config_medio      [L,QSA]
RewriteRule ^admin/caja/config/categoria/?$  index.php?route=caja_config_categoria  [L,QSA]
RewriteRule ^admin/caja/config/orden/?$      index.php?route=caja_config_orden      [L,QSA]

RewriteRule ^admin/caja/?$             index.php?route=caja             [L,QSA]
RewriteRule ^admin/caja/gasto/?$       index.php?route=caja_gasto       [L,QSA]
RewriteRule ^admin/caja/ingreso/?$     index.php?route=caja_ingreso     [L,QSA]
RewriteRule ^admin/caja/transferir/?$  index.php?route=caja_transferir  [L,QSA]
RewriteRule ^admin/caja/ajustar/?$     index.php?route=caja_ajustar     [L,QSA]
RewriteRule ^admin/caja/anular/?$      index.php?route=caja_anular      [L,QSA]

# Resets de contraseña (admin)
RewriteRule ^admin/resets/?$ index.php?route=admin_resets [L,QSA]
RewriteRule ^admin/resets/limpiar/?$ index.php?route=admin_resets_limpiar [L,QSA]

# Categorías
RewriteRule ^admin/categorias/?$              index.php?route=categorias [L,QSA]
RewriteRule ^admin/categorias/crear/?$        index.php?route=categorias_crear [L,QSA]
RewriteRule ^admin/categorias/guardar/?$      index.php?route=categorias_guardar [L,QSA]
RewriteRule ^admin/categorias/editar/?$       index.php?route=categorias_editar [L,QSA]
RewriteRule ^admin/categorias/actualizar/?$   index.php?route=categorias_actualizar [L,QSA]
RewriteRule ^admin/categorias/eliminar/?$     index.php?route=categorias_eliminar [L,QSA]

# Marcas
RewriteRule ^admin/marcas/?$                  index.php?route=marcas [L,QSA]
RewriteRule ^admin/marcas/crear/?$            index.php?route=marcas_crear [L,QSA]
RewriteRule ^admin/marcas/guardar/?$          index.php?route=marcas_guardar [L,QSA]
RewriteRule ^admin/marcas/editar/?$           index.php?route=marcas_editar [L,QSA]
RewriteRule ^admin/marcas/actualizar/?$       index.php?route=marcas_actualizar [L,QSA]
RewriteRule ^admin/marcas/eliminar/?$         index.php?route=marcas_eliminar [L,QSA]

# Productos
RewriteRule ^admin/productos/?$                     index.php?route=productos                     [L,QSA]
RewriteRule ^admin/productos/crear/?$               index.php?route=productos_crear               [L,QSA]
RewriteRule ^admin/productos/guardar/?$             index.php?route=productos_guardar             [L,QSA]
RewriteRule ^admin/productos/editar/?$              index.php?route=productos_editar              [L,QSA]
RewriteRule ^admin/productos/actualizar/?$          index.php?route=productos_actualizar          [L,QSA]
RewriteRule ^admin/productos/eliminar/?$            index.php?route=productos_eliminar            [L,QSA]
RewriteRule ^admin/productos/duplicar/?$            index.php?route=productos_duplicar            [L,QSA]
RewriteRule ^admin/productos/masivo/?$              index.php?route=productos_masivo              [L,QSA]
RewriteRule ^admin/productos/toggle/?$              index.php?route=productos_toggle              [L,QSA]
RewriteRule ^admin/productos/modal/?$               index.php?route=productos_modal               [L,QSA]
RewriteRule ^admin/productos/exportar/?$            index.php?route=productos_exportar            [L,QSA]
RewriteRule ^admin/productos/importar/?$                index.php?route=productos_importar               [L,QSA]
RewriteRule ^admin/productos/importar/previsualizar/?$  index.php?route=productos_importar_previsualizar [L,QSA]
RewriteRule ^admin/productos/importar/aplicar/?$        index.php?route=productos_importar_aplicar       [L,QSA]
RewriteRule ^admin/productos/variantes/?$           index.php?route=productos_variantes           [L,QSA]
RewriteRule ^admin/productos/guardar-variante/?$    index.php?route=productos_guardar_variante    [L,QSA]
RewriteRule ^admin/productos/guardar-variantes/?$   index.php?route=productos_guardar_variantes   [L,QSA]
RewriteRule ^admin/productos/editar-variante/?$     index.php?route=productos_editar_variante     [L,QSA]
RewriteRule ^admin/productos/actualizar-variante/?$ index.php?route=productos_actualizar_variante [L,QSA]
RewriteRule ^admin/productos/eliminar-variante/?$   index.php?route=productos_eliminar_variante   [L,QSA]
RewriteRule ^admin/productos/editar-variantes/?$    index.php?route=productos_editar_variantes    [L,QSA]
RewriteRule ^admin/productos/eliminar-variantes/?$  index.php?route=productos_eliminar_variantes  [L,QSA]
RewriteRule ^admin/productos/color-variantes/?$     index.php?route=productos_color_variantes     [L,QSA]
RewriteRule ^admin/productos/fotos/?$               index.php?route=productos_fotos               [L,QSA]
RewriteRule ^admin/productos/subir-foto/?$          index.php?route=productos_subir_foto          [L,QSA]
RewriteRule ^admin/productos/subir-foto-ajax/?$     index.php?route=productos_subir_foto_ajax     [L,QSA]
RewriteRule ^admin/productos/eliminar-foto/?$       index.php?route=productos_eliminar_foto       [L,QSA]
RewriteRule ^admin/productos/ordenar-fotos/?$       index.php?route=productos_ordenar_fotos       [L,QSA]

# Talles
RewriteRule ^admin/talles/?$            index.php?route=talles             [L,QSA]
RewriteRule ^admin/talles/crear/?$      index.php?route=talles_crear       [L,QSA]
RewriteRule ^admin/talles/guardar/?$    index.php?route=talles_guardar     [L,QSA]
RewriteRule ^admin/talles/editar/?$     index.php?route=talles_editar      [L,QSA]
RewriteRule ^admin/talles/actualizar/?$ index.php?route=talles_actualizar  [L,QSA]
RewriteRule ^admin/talles/eliminar/?$   index.php?route=talles_eliminar    [L,QSA]
RewriteRule ^admin/talles/crear-ajax/?$ index.php?route=talles_crear_ajax  [L,QSA]

# Promociones
RewriteRule ^admin/promociones/?$                index.php?route=promociones                [L,QSA]
RewriteRule ^admin/promociones/nueva/?$          index.php?route=promociones_nueva          [L,QSA]
RewriteRule ^admin/promociones/editar/?$         index.php?route=promociones_editar         [L,QSA]
RewriteRule ^admin/promociones/guardar/?$        index.php?route=promociones_guardar        [L,QSA]
RewriteRule ^admin/promociones/ver/?$            index.php?route=promociones_ver            [L,QSA]
RewriteRule ^admin/promociones/toggle/?$         index.php?route=promociones_toggle         [L,QSA]
RewriteRule ^admin/promociones/eliminar/?$       index.php?route=promociones_eliminar       [L,QSA]
RewriteRule ^admin/promociones/productos/?$      index.php?route=promociones_productos      [L,QSA]
RewriteRule ^admin/promociones/oferta-rapida/?$  index.php?route=promociones_oferta_rapida  [L,QSA]

# Catálogo
RewriteRule ^admin/catalogo/?$      index.php?route=catalogo      [L,QSA]
RewriteRule ^admin/catalogo/ver/?$  index.php?route=catalogo_ver  [L,QSA]

# Colores
RewriteRule ^admin/colores/?$            index.php?route=colores            [L,QSA]
RewriteRule ^admin/colores/crear/?$      index.php?route=colores_crear      [L,QSA]
RewriteRule ^admin/colores/guardar/?$    index.php?route=colores_guardar    [L,QSA]
RewriteRule ^admin/colores/editar/?$     index.php?route=colores_editar     [L,QSA]
RewriteRule ^admin/colores/actualizar/?$ index.php?route=colores_actualizar [L,QSA]
RewriteRule ^admin/colores/eliminar/?$   index.php?route=colores_eliminar   [L,QSA]
RewriteRule ^admin/colores/crear-ajax/?$ index.php?route=colores_crear_ajax [L,QSA]

# Configuración
RewriteRule ^admin/configuracion/?$                 index.php?route=admin_configuracion                  [L,QSA]
RewriteRule ^admin/configuracion/guardar/?$         index.php?route=admin_configuracion_guardar          [L,QSA]
RewriteRule ^admin/configuracion/eliminar-imagen/?$ index.php?route=admin_configuracion_eliminar_imagen  [L,QSA]

# Auth admin
RewriteRule ^admin/login/?$             index.php?route=admin_login            [L,QSA]
RewriteRule ^admin/ingresar/?$          index.php?route=admin_ingresar         [L,QSA]
RewriteRule ^admin/logout/?$            index.php?route=admin_logout           [L,QSA]
RewriteRule ^admin/cuenta/?$            index.php?route=admin_cuenta           [L,QSA]
RewriteRule ^admin/cuenta/password/?$   index.php?route=admin_cuenta_password  [L,QSA]

# Raíz -> tienda
RewriteRule ^/?$ index.php?route=tienda [L,QSA]

# Cualquier otra URL que no sea un archivo real -> 404 de la tienda
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php?route=404 [L,QSA]